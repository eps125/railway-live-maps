APP_ENV=development
APP_TAG=latest
# WEB_PORT/API_PORT are the HOST-side ports these services are published on — safe to change
# to whatever's free on your host.
WEB_PORT=6050
API_PORT=6051
# PORT is different: it's the api container's INTERNAL listen port. apps/web/nginx.conf
# proxies to `api:3000` unconditionally, so changing PORT away from 3000 breaks the web ->
# api proxy (502 Bad Gateway) even though the container itself is running fine. Leave this
# at 3000 — it has nothing to do with WEB_PORT/API_PORT and does not need to be "numbered
# alongside" them.
PORT=3000
# Not yet consumed by any service (no code reads this at runtime) — docs/ARCHITECTURE.md
# lists it as an intended setting, but it's documentation-only until something actually wires
# it up. Kept in sync with WEB_PORT for whenever that lands.
PUBLIC_BASE_URL=http://localhost:6050
DISPLAY_TIMEZONE=Europe/London

POSTGRES_DB=railway_live_maps
POSTGRES_USER=railway
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql://railway:replace-me@postgres:5432/railway_live_maps
REDIS_URL=redis://redis:6379

# Host port mappings — only used by deploy/docker-compose.portainer.yml, which publishes
# Postgres/Redis/MinIO for direct testing access. docs/ARCHITECTURE.md §12 says only the
# web entry point should normally be public; these are a deliberate exception for a
# single-operator testing/staging box, not a production recommendation.
# Numbered to sit right after this deployment's WEB_PORT/API_PORT above — adjust if those change.
POSTGRES_PORT=6052
REDIS_PORT=6053
MINIO_PORT=6054
MINIO_CONSOLE_PORT=6055

# Nationwide ingestion is mandatory. Do not replace this with an area allow-list.
CAPTURE_ALL_TD=true

RAW_ARCHIVE_ENDPOINT=http://archive:9000
RAW_ARCHIVE_BUCKET=railway-raw
RAW_ARCHIVE_ACCESS_KEY=replace-me
RAW_ARCHIVE_SECRET_KEY=replace-me
RAW_ARCHIVE_REGION=us-east-1

NR_TD_TOPIC=/topic/TD_ALL_SIG_AREA
NR_TRUST_TOPIC=/topic/TRAIN_MVT_ALL_TOC
NR_VSTP_TOPIC=/topic/VSTP_ALL
# Real credentials are never set here in Git. For deploy/docker-compose.yml (local/dev),
# create deploy/secrets/nr_username.txt and deploy/secrets/nr_password.txt instead — see
# deploy/secrets/README.md. For deploy/docker-compose.portainer.yml, set NR_USERNAME/
# NR_PASSWORD directly in Portainer's stack environment editor (never here, never in Git).
# Each *_LIVE_ENABLED flag independently gates its own always-running ingest-{td,vstp,trust}
# service in docker-compose.portainer.yml — flip one and redeploy that service to start/stop
# that feed; the other two keep idling.
NR_USERNAME=
NR_PASSWORD=
TD_LIVE_ENABLED=true
VSTP_LIVE_ENABLED=true
TRUST_LIVE_ENABLED=true

# SCHEDULE/CORPUS/SMART full-extract download endpoints (docs/IMPLEMENTATION_PLAN.md
# Milestone 7) — CORPUS/SMART confirmed correct against real downloads on 2026-08-10.
# SCHEDULE originally pointed at SupportingFileAuthenticate like the other two (a 404 in
# production, confirmed 2026-08-10) — the real CIF full extract lives at a different
# endpoint, CifFileAuthenticate, and needs the extra day=toc-full param below.
# `download-smart`/`download-schedule`/`download-corpus` also need NR_USERNAME/NR_PASSWORD
# above and SCHEDULE_DOWNLOAD_ENABLED=true.
NR_SCHEDULE_DOWNLOAD_URL=https://publicdatafeeds.networkrail.co.uk/ntrod/CifFileAuthenticate?type=CIF_ALL_FULL_DAILY&day=toc-full
NR_CORPUS_DOWNLOAD_URL=https://publicdatafeeds.networkrail.co.uk/ntrod/SupportingFileAuthenticate?type=CORPUS
NR_SMART_DOWNLOAD_URL=https://publicdatafeeds.networkrail.co.uk/ntrod/SupportingFileAuthenticate?type=SMART
# Gates both the manual download-{schedule,smart,corpus} console commands AND the always-running
# reference-data-refresh service, which calls all three automatically once a day at
# REFERENCE_DATA_REFRESH_TIME below (docker-compose.portainer.yml) — same on/off discipline as
# TD/VSTP/TRUST_LIVE_ENABLED. Defaulting it true means reference data refreshes daily out of the
# box; NR_USERNAME/NR_PASSWORD above still have to be set for it to actually run.
SCHEDULE_DOWNLOAD_ENABLED=true
# Europe/London wall-clock time (24h HH:MM) reference-data-refresh runs at each day. Only takes
# effect while SCHEDULE_DOWNLOAD_ENABLED is true.
REFERENCE_DATA_REFRESH_TIME=01:00

# Defaults to true in docker-compose.portainer.yml (worker and api must agree — see the
# compose file's own comments). When true, the public map's WebSocket layer gets pushed
# real-time deltas from the map-deltas service via Redis pub/sub instead of falling back to
# polling Postgres every ~1s — this is what makes the map feel genuinely live.
LIVE_WS_REDIS_PUBSUB_ENABLED=true
# Fallback poll interval when LIVE_WS_REDIS_PUBSUB_ENABLED is false, and the interval the API
# re-checks map version regardless (apps/api/src/config.ts).
LIVE_WS_POLL_INTERVAL_MS=1000
# The `project-resolver` live loop only resolves berth occupancies entered within this many
# hours (default 72). Stops a RESOLVER_VERSION bump from grinding oldest-first through the whole
# retained history before the live map reflects "now". Older resolver history is caught up on
# demand: `project-resolver --backfill --since <YYYY-MM-DD>`. `--rebuild` ignores this.
RESOLVER_LIVE_WINDOW_HOURS=72
# Eager berth-run resolution scoped to areas a published map binds (Milestone 15 step 5).
# Set to false to eagerly resolve every observed area.
RESOLVER_EAGER_MAPPED_AREAS_ONLY=true
# garner bridge (ADR 0002) — read TRUST/VSTP-schedule/CORPUS/SMART from the operator's
# openrail-eps MariaDB instead of subscribing to Network Rail again. Off by default; when true
# GARNER_DB_* must be set (use a read-only GRANT SELECT user — see openrail-eps docker/README).
GARNER_BRIDGE_ENABLED=false
GARNER_DB_HOST=
GARNER_DB_PORT=3306
GARNER_DB_NAME=rail
GARNER_DB_USER=
GARNER_DB_PASSWORD=
GARNER_BRIDGE_BACKFILL_DAYS=14

EDITOR_ENABLED=true
